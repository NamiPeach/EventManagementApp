@model List<Registration>

@{
    ViewData["Title"] = "Реєстрації";
}

<h2>Реєстрації</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Додати реєстрацію</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Учасник</th>
            <th>Подія</th>
            <th>Організатор</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ParticipantName</td>
                <td>@item.Event?.Name</td>
                <td>@item.Organizer?.Name</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-secondary">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
