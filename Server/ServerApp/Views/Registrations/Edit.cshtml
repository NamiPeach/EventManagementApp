@model Registration

@{
    ViewData["Title"] = "Редагувати реєстрацію";
}

<h2>Редагувати реєстрацію</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID" />
    <div class="mb-3">
        <label class="form-label">Подія</label>
        <select asp-for="EventID" class="form-control" asp-items="ViewBag.Events"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Організатор</label>
        <select asp-for="OrganizerID" class="form-control" asp-items="ViewBag.Organizers"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Ім'я учасника</label>
        <input asp-for="ParticipantName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Статус</label>
        <input asp-for="Status" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>
