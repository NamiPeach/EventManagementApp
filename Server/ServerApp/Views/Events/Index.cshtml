@model List<Event>

@{
    ViewData["Title"] = "Події";
}

<h2>Події</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Додати подію</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Назва</th>
            <th>Дата</th>
            <th>Місце</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Date</td>
                <td>@item.Location</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-secondary">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
