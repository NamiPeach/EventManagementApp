@model Event

@{
    ViewData["Title"] = "Додати подію";
}

<h2>Додати подію</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Назва</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Дата (РРРР-ММ-ДД)</label>
        <input asp-for="Date" class="form-control" placeholder="2026-10-15" />
    </div>
    <div class="mb-3">
        <label class="form-label">Місце</label>
        <input asp-for="Location" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>
