@model Event

@{
    ViewData["Title"] = "Видалити подію";
}

<h2>Видалити подію</h2>

<p>Ти впевнений?</p>

<dl class="row">
    <dt class="col-sm-2">Назва</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Дата</dt>
    <dd class="col-sm-10">@Model.Date</dd>
    <dt class="col-sm-2">Місце</dt>
    <dd class="col-sm-10">@Model.Location</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>
